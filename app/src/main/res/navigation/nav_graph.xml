<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/mainFragment">

    <!-- 로그인 화면 -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.moyeoyo.app.ui.auth.LoginFragment"
        android:label="로그인"
        tools:layout="@layout/fragment_login">

        <!-- 로그인 성공 → 프로필 설정 (최초 로그인 시) -->
        <action
            android:id="@+id/action_loginFragment_to_profileSetupFragment"
            app:destination="@id/profileSetupFragment" />

        <!-- 로그인 성공 → 바로 메인 (기존 사용자) -->
        <action
            android:id="@+id/action_loginFragment_to_mainFragment"
            app:destination="@id/mainFragment" />
    </fragment>

    <!-- 프로필 설정 화면 -->
    <fragment
        android:id="@+id/profileSetupFragment"
        android:name="com.moyeoyo.app.ui.auth.ProfileSetupFragment"
        android:label="프로필 설정"
        tools:layout="@layout/fragment_profile_setup">

        <!-- 프로필 저장 완료 → 메인 화면 -->
        <action
            android:id="@+id/action_profileSetupFragment_to_mainFragment"
            app:destination="@id/mainFragment" />
    </fragment>

    <!-- 메인 화면 -->
    <fragment
        android:id="@+id/mainFragment"
        android:name="com.moyeoyo.app.ui.main.MainFragment"
        android:label="메인"
        tools:layout="@layout/fragment_main">

        <!-- 메인 → 로그인 (로그인 안된 경우 이동) -->
        <action
            android:id="@+id/action_mainFragment_to_loginFragment"
            app:destination="@id/loginFragment" />

        <!-- 알림 화면으로 이동 -->
        <action
            android:id="@+id/action_mainFragment_to_notificationFragment"
            app:destination="@id/notificationFragment" />

        <!-- 그룹 상세 -->
        <action
            android:id="@+id/action_mainFragment_to_groupDetailFragment"
            app:destination="@id/groupDetailFragment" />

        <!-- 새 그룹 만들기 -->
        <action
            android:id="@+id/action_mainFragment_to_createGroupFragment"
            app:destination="@id/createGroupFragment" />

        <!-- 프로필 설정 -->
        <action
            android:id="@+id/action_mainFragment_to_profileSetupFragment"
            app:destination="@id/profileSetupFragment" />

        <!-- 로그아웃 시 로그인 화면으로 이동 -->
        <action
            android:id="@+id/action_mainFragment_to_loginFragment_logout"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_mainFragment_to_friendSearchFragment"
            app:destination="@id/friendSearchFragment" />

    </fragment>

    <fragment
        android:id="@+id/notificationFragment"
        android:name="com.moyeoyo.app.ui.notification.NotificationFragment"
        android:label="알림"
        tools:layout="@layout/fragment_notification" />

    <!-- 그룹 상세 화면 -->
    <fragment
        android:id="@+id/groupDetailFragment"
        android:name="com.moyeoyo.app.ui.group.GroupDetailFragment"
        android:label="그룹 상세"
        tools:layout="@layout/fragment_group_detail">

        <argument
            android:name="groupId"
            app:argType="string" />
        <argument
            android:name="groupName"
            app:argType="string" />
        <argument
            android:name="memberCount"
            app:argType="integer" />

        <action
            android:id="@+id/action_groupDetailFragment_to_inviteGroupFragment"
            app:destination="@id/inviteGroupFragment" />

        <!-- 위치 입력 화면 -->
        <action
            android:id="@+id/action_groupDetailFragment_to_locationInputFragment"
            app:destination="@id/locationInputFragment" />

        <!-- 시간 투표 화면 -->
        <action
            android:id="@+id/action_groupDetailFragment_to_timeVoteFragment"
            app:destination="@id/timeVoteFragment" />

        <!-- 그룹 상세 → 메인으로 돌아가기 -->
        <action
            android:id="@+id/action_groupDetailFragment_to_mainFragment"
            app:destination="@id/mainFragment"
            app:popUpTo="@id/mainFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_groupDetailFragment_to_shareMeetingFragment"
            app:destination="@id/shareMeetingFragment" />

        <action
            android:id="@+id/action_groupDetailFragment_to_calendarSyncFragment"
            app:destination="@id/calendarSyncFragment" />
    </fragment>

    <!-- 위치 입력 -->
    <fragment
        android:id="@+id/locationInputFragment"
        android:name="com.moyeoyo.app.ui.group.LocationInputFragment"
        android:label="위치 입력"
        tools:layout="@layout/fragment_location_input">

        <!-- 위치 입력 → 중간지점 계산 -->
        <action
            android:id="@+id/action_locationInputFragment_to_midpointFragment"
            app:destination="@id/midpointFragment" />
    </fragment>

    <!-- 중간지점 계산 -->
    <fragment
        android:id="@+id/midpointFragment"
        android:name="com.moyeoyo.app.ui.group.MidpointFragment"
        android:label="중간 지점 계산"
        tools:layout="@layout/fragment_midpoint">

        <argument
            android:name="selectedLocation"
            app:argType="com.moyeoyo.app.model.SelectedLocation"
            app:nullable="true" />

        <!-- 중간지점 → 추천 장소 -->
        <action
            android:id="@+id/action_midpointFragment_to_recommendedPlaceFragment"
            app:destination="@id/recommendedPlaceFragment" />
    </fragment>

    <!-- 추천 장소 -->
    <fragment
        android:id="@+id/recommendedPlaceFragment"
        android:name="com.moyeoyo.app.ui.group.RecommendedPlaceFragment"
        android:label="주변 장소 추천"
        tools:layout="@layout/fragment_recommended_place" />

    <!-- 시간 투표 -->
    <fragment
        android:id="@+id/timeVoteFragment"
        android:name="com.moyeoyo.app.ui.group.TimeVoteFragment"
        android:label="시간 투표"
        tools:layout="@layout/fragment_time_vote" />

    <!-- 새 그룹 생성 -->
    <fragment
        android:id="@+id/createGroupFragment"
        android:name="com.moyeoyo.app.ui.group.CreateGroupFragment"
        android:label="그룹 만들기"
        tools:layout="@layout/fragment_create_group">

        <!-- 그룹 생성 완료 → 초대 화면 -->
        <action
            android:id="@+id/action_createGroupFragment_to_inviteGroupFragment"
            app:destination="@id/inviteGroupFragment" />
    </fragment>

    <!-- 그룹 초대 -->
    <fragment
        android:id="@+id/inviteGroupFragment"
        android:name="com.moyeoyo.app.ui.group.InviteGroupFragment"
        android:label="그룹 초대"
        tools:layout="@layout/fragment_invite_group">

        <!-- 인자 추가 -->
        <argument
            android:name="groupId"
            app:argType="string" />

        <argument
            android:name="groupName"
            app:argType="string" />

<!--        그룹 생성 때 선택한 친구들 전달-->
        <argument
            android:name="invitedFriendUids"
            app:argType="string[]"
            app:nullable="true" />

        <!-- 초대 완료 후 메인 화면으로 이동 -->
        <action
            android:id="@+id/action_inviteGroupFragment_to_mainFragment"
            app:destination="@id/mainFragment"
            app:popUpTo="@id/mainFragment"
            app:popUpToInclusive="true" />

        <!-- 그룹 상세로 이동 -->
        <action
            android:id="@+id/action_inviteGroupFragment_to_groupDetailFragment"
            app:destination="@id/groupDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/shareMeetingFragment"
        android:name="com.moyeoyo.app.ui.group.ShareMeetingFragment"
        android:label="약속 공유"
        tools:layout="@layout/fragment_share_meeting">

        <argument
            android:name="groupId"
            app:argType="string" />

        <argument
            android:name="groupName"
            app:argType="string" />

        <argument
            android:name="meetingTime"
            app:argType="string"
            app:nullable="true" />

        <argument
            android:name="meetingPlace"
            app:argType="string"
            app:nullable="true" />

        <argument
            android:name="memberCount"
            android:defaultValue="0"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/friendSearchFragment"
        android:name="com.moyeoyo.app.ui.friend.FriendSearchFragment"
        android:label="친구 검색"
        tools:layout="@layout/fragment_friends_search" />

    <fragment
        android:id="@+id/calendarSyncFragment"
        android:name="com.moyeoyo.app.ui.calendar.CalendarSyncFragment"
        android:label="캘린더 연동"
        tools:layout="@layout/fragment_calendar_sync">

        <argument android:name="title" app:argType="string" />
        <argument android:name="dateTime" app:argType="string" />
        <argument android:name="place" app:argType="string" />
    </fragment>
</navigation>
