<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- 흰색 배경 -->
    <solid android:color="#FFFFFF" />

    <!-- 살짝 둥근 모서리 -->
    <corners android:radius="12dp" />

    <!-- 연한 회색 테두리 -->
    <stroke
        android:width="1dp"
        android:color="#E5E7EB" />

    <!-- 약간의 그림자 효과 -->
    <padding
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp" />
</shape>
