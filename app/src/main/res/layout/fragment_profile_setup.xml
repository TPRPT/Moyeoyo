<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".ui.auth.ProfileSetupActivity">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF">

        <!-- 툴바 -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#FFFFFF"
            app:navigationIcon="@drawable/ic_chevron_left_24"
            android:elevation="0dp"
            android:fitsSystemWindows="true" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingTop="16dp"
                android:paddingBottom="28dp"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="프로필 설정"
                    android:textColor="#111"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="기본 정보를 입력해주세요"
            android:textColor="#666"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp" />

        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/profile_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_user_placeholder"
                android:scaleType="centerCrop"
                android:background="@drawable/circle_background"
                android:contentDescription="프로필 이미지" />

            <ImageView
                android:id="@+id/btn_change_photo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_camera"
                android:background="@drawable/bg_camera_button"
                android:layout_gravity="bottom|end"
                android:layout_margin="6dp"
                android:padding="8dp" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="프로필 이미지 추가"
            android:textColor="#666"
            android:textSize="13sp"
            android:layout_marginBottom="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="닉네임 *"
            android:textColor="#111"
            android:textSize="15sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/input_nickname"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input_field"
            android:hint="닉네임을 입력하세요"
            android:paddingHorizontal="16dp"
            android:textSize="14sp"
            android:layout_marginBottom="20dp"
            android:textColor="#333333"
            android:textColorHint="#999999" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="집 주소 *"
                android:textColor="#111"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/input_home"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_field"
                android:hint="주소를 검색하여 설정하세요"
                android:paddingHorizontal="16dp"
                android:textSize="14sp"
                android:layout_marginBottom="6dp"
                android:focusable="false"
                android:clickable="true"
                android:drawableRight="@drawable/ic_search"
                android:drawablePadding="8dp"
                android:textColor="#333333"
                android:textColorHint="#999999" />

            <Button
                android:id="@+id/btn_set_current_home"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="현재 위치로 설정"
                android:backgroundTint="#8B8B8B"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="회사 주소"
                android:textColor="#111"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/input_work"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_field"
                android:hint="주소를 검색하여 설정하세요 (선택)"
                android:paddingHorizontal="16dp"
                android:textSize="14sp"
                android:layout_marginBottom="6dp"
                android:focusable="false"
                android:clickable="true"
                android:drawableRight="@drawable/ic_search"
                android:drawablePadding="8dp"
                android:textColor="#333333"
                android:textColorHint="#999999" />

            <Button
                android:id="@+id/btn_set_current_work"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="현재 위치로 설정"
                android:backgroundTint="#8B8B8B"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:layout_marginBottom="40dp" />

        </LinearLayout>

        <Button
            android:id="@+id/btn_save_profile"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="프로필 설정"
            android:backgroundTint="#3B82F6"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:layout_marginBottom="32dp" />

        <TextView
            android:id="@+id/btn_delete_account"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="회원 탈퇴"
            android:textColor="#999999"
            android:textSize="12sp"
            android:padding="8dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>