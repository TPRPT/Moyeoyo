<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    tools:context=".ui.group.InviteGroupFragment">

    <!-- 상단 헤더 -->
    <LinearLayout
        android:id="@+id/headerLayoutInvite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="32dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp"
        android:background="@android:color/white"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/backButtonInvite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_arrow_back"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="뒤로가기" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="그룹이 생성되었습니다!"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="친구들을 초대하세요"
            android:textColor="@color/gray_600"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- 본문 스크롤 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayoutInvite"
        app:layout_constraintBottom_toTopOf="@id/bottomCompleteLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- 상단 성공 카드 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingVertical="32dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_check_circle_green"
                    android:background="@drawable/bg_circle_green_light"
                    android:padding="16dp"
                    android:layout_marginBottom="8dp"
                    android:contentDescription="성공 아이콘" />

                <TextView
                    android:id="@+id/createdGroupNameText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:text="[그룹 이름]"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="그룹이 만들어졌어요"
                    android:textColor="@color/gray_600"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 초대 링크 섹션 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="초대 링크"
                android:drawableStart="@drawable/ic_link_24"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <EditText
                    android:id="@+id/inviteLinkEditText"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_rounded"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:focusable="false"
                    android:clickable="true"
                    android:cursorVisible="false" />

                <ImageButton
                    android:id="@+id/copyLinkButtonIcon"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_round_button"
                    android:backgroundTint="@color/light_gray"
                    android:src="@drawable/ic_copy"
                    app:tint="@color/black"
                    android:contentDescription="링크 복사" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="이 링크를 친구들에게 공유하여 그룹에 초대하세요"
                android:textColor="@color/gray_600"
                android:textSize="14sp"
                android:layout_marginBottom="24dp" />

            <!-- 초대한 친구 목록 컨테이너 (동적으로 채움) -->
            <LinearLayout
                android:id="@+id/invitedFriendsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_light_gray_outline"
                android:visibility="gone"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="초대한 친구"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/invitedFriendsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- 링크 복사 / 카카오 공유 버튼들 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/copyLinkButtonFull"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="링크 복사하기"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:background="@drawable/bg_round_button"
                app:backgroundTint="@color/light_gray"
                app:icon="@drawable/ic_copy"
                app:iconGravity="start"
                app:iconPadding="12dp"
                android:paddingStart="24dp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/shareKakaoButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="카카오톡으로 공유"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:background="@drawable/bg_round_button"
                app:backgroundTint="@color/quantum_yellow700"
                app:icon="@drawable/ic_kakao_24"
                app:iconGravity="start"
                app:iconPadding="12dp"
                android:paddingStart="24dp"
                android:layout_marginBottom="32dp" />

        </LinearLayout>
    </ScrollView>

    <!-- 하단 버튼 영역 -->
    <LinearLayout
        android:id="@+id/bottomCompleteLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:padding="24dp"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/goToGroupButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="그룹으로 이동"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_round_button"
            app:backgroundTint="@color/brand_blue" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
