<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- 상단 APP BAR -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarInvite"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_chevron_left_24"
            app:title=""
            android:background="@color/white"
            app:contentInsetStartWithNavigation="0dp" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- 전체 스크롤 영역 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="100dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Title -->
            <TextView
                android:id="@+id/pageTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="그룹이 생성되었습니다!"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:paddingTop="16dp"
                android:paddingBottom="4dp"/>

            <!-- Subtitle -->
            <TextView
                android:id="@+id/pageSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="친구들을 그룹에 초대해보세요"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:paddingBottom="12dp"/>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/light_gray"
                android:layout_marginBottom="20dp"/>

            <!-- 성공 카드 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingVertical="32dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_check_circle_green"
                    android:background="@drawable/bg_circle_green_light"
                    android:padding="16dp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/createdGroupNameText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[그룹 이름]"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="그룹이 만들어졌어요"
                    android:textColor="@color/gray_600"
                    android:textSize="14sp"/>
            </LinearLayout>

            <!-- 초대 링크 텍스트 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="초대 링크"
                android:drawableStart="@drawable/ic_link_24"
                android:drawablePadding="8dp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="12dp"/>

            <!-- 초대 링크 + 아이콘 -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <EditText
                    android:id="@+id/inviteLinkEditText"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_rounded"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="14sp"
                    android:focusable="false"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:textColor="@color/black"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="이 링크를 친구들에게 공유하여 그룹에 초대하세요"
                android:textSize="14sp"
                android:textColor="@color/gray_600"
                android:layout_marginBottom="24dp"/>

            <!-- 초대한 친구 리스트 -->
            <LinearLayout
                android:id="@+id/invitedFriendsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_light_gray_outline"
                android:visibility="gone"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="초대한 친구"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:id="@+id/invitedFriendsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>

            <!-- 버튼: 링크 복사 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/copyLinkButtonFull"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="링크 복사하기"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:background="@drawable/bg_round_button"
                app:backgroundTint="@color/light_gray"
                app:icon="@drawable/ic_copy"
                app:iconGravity="start"
                app:iconPadding="12dp"
                android:paddingStart="24dp"
                android:layout_marginBottom="8dp"/>

            <!-- 버튼: 카카오 공유 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/shareKakaoButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="카카오톡으로 공유"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:background="@drawable/bg_round_button"
                app:backgroundTint="@color/quantum_yellow700"
                app:icon="@drawable/ic_kakao_24"
                app:iconGravity="start"
                app:iconPadding="12dp"
                android:paddingStart="24dp"
                android:layout_marginBottom="32dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 하단 고정 버튼 -->
    <LinearLayout
        android:id="@+id/bottomCompleteLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:padding="20dp"
        android:elevation="8dp"
        android:layout_gravity="bottom">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/goToGroupButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="그룹으로 이동"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/bg_round_button"
            app:backgroundTint="@color/brand_blue"/>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
