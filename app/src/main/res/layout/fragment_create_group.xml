<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- 상단 APP BAR -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_chevron_left_24"
            app:title=""
            android:background="@color/white"
            app:contentInsetStartWithNavigation="0dp" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- 스크롤 가능한 전체 내용 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/createGroupScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Title -->
            <TextView
                android:id="@+id/pageTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="새 그룹 만들기"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:paddingTop="16dp"
                android:paddingBottom="4dp" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/pageSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="함께 약속을 잡을 그룹을 만드세요"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:paddingBottom="12dp" />

            <!-- ====== 본문 UI 시작 ===== -->

            <!-- 그룹 아이콘 -->
            <androidx.cardview.widget.CardView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center_horizontal"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                android:layout_marginBottom="32dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#6C5CE7"
                    android:src="@drawable/ic_users"
                    android:padding="20dp"
                    android:contentDescription="그룹 아이콘" />
            </androidx.cardview.widget.CardView>

            <!-- 그룹 이름 입력 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="그룹 이름 *"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/groupNameEditText"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="예: 대학 동기들, 회사 동료"
                android:inputType="text"
                android:maxLines="1"
                android:background="@drawable/bg_input_rounded"
                android:paddingStart="14dp"
                android:paddingEnd="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="그룹을 쉽게 구분할 수 있는 이름을 지어주세요"
                android:textColor="@color/gray_600"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp" />

            <!-- 친구 초대 Header -->
            <LinearLayout
                android:id="@+id/inviteHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="친구 초대하기"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/tvSelectedCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0명 선택됨"
                    android:textSize="14sp"
                    android:textColor="@color/gray_600" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="그룹을 만들 때 바로 친구들을 초대할 수 있어요"
                android:textColor="@color/gray_600"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />

            <!-- 친구 리스트 카드 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/light_gray"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                android:padding="12dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/friendInviteRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </androidx.cardview.widget.CardView>

            <!-- 안내 박스 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_info_box_blue">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="그룹을 만들면"
                    android:textStyle="bold"
                    android:textColor="#003366"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_check_blue"
                    android:drawablePadding="8dp"
                    android:text="초대 링크로 친구들을 초대할 수 있어요"
                    android:textColor="#003366"
                    android:lineSpacingExtra="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_check_blue"
                    android:drawablePadding="8dp"
                    android:text="함께 약속 장소와 시간을 정할 수 있어요"
                    android:textColor="#003366"
                    android:lineSpacingExtra="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_check_blue"
                    android:drawablePadding="8dp"
                    android:text="투표로 모두의 의견을 반영할 수 있어요"
                    android:textColor="#003366"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 하단 고정 버튼 -->
    <LinearLayout
        android:id="@+id/bottomFixedLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:padding="20dp"
        android:elevation="12dp"
        android:layout_gravity="bottom">

        <Button
            android:id="@+id/createGroupButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="그룹 만들기"
            android:enabled="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="@color/brand_blue"
            android:textColor="@android:color/white" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
