<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F8FF"
    tools:context=".ui.auth.LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center_horizontal">

        <!-- 🔹 앱 로고 -->
        <androidx.cardview.widget.CardView
            xmlns:card_view="http://schemas.android.com/apk/res-auto"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="80dp"
            android:layout_marginBottom="16dp"
            card_view:cardCornerRadius="28dp"
            card_view:cardElevation="8dp"
            android:background="@drawable/bg_logo_card"
            android:layout_gravity="center">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:src="@drawable/ic_moyeoyo_logo"
                android:contentDescription="앱 로고"
                android:padding="8dp"/>
        </androidx.cardview.widget.CardView>

        <!-- 🔹 앱 이름 -->
        <TextView
            android:id="@+id/app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Moyeoyo"
            android:textColor="#222"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <!-- 🔹 부제 -->
        <TextView
            android:id="@+id/app_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="모여요"
            android:textColor="#3B82F6"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp" />

        <!-- 🔹 설명 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="친구들과의 모임을 위한 최적의 중간 지점을 찾고\n일정을 쉽게 조율하세요"
            android:textColor="#666"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="40dp" />

        <!-- 🔹 기능 리스트 -->

        <!-- 🔹 Google 로그인 버튼 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="48dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="📍 중간 지점 계산  —  모두에게 공평한 만남 장소 추천"
                android:textColor="#444"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="📅 일정 조율  —  투표로 최적의 시간 선택"
                android:textColor="#444"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👥 그룹 관리  —  친구들을 초대하고 함께 결정"
                android:textColor="#444"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_google_login"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_google_button"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_google_logo"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Google 계정으로 로그인"
                android:textColor="#000"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="로그인하여 모임을 시작하세요"
            android:textColor="#777"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
