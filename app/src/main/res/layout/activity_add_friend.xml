<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".ui.friends.AddFriendActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="친구 이메일 검색"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/edit_text_email"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="친구의 이메일을 입력하세요"
            android:inputType="textEmailAddress"
            android:padding="12dp"
            android:background="@drawable/bg_input_field"
            android:imeOptions="actionSearch"/>

        <Button
            android:id="@+id/btn_search_friend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="검색"
            android:layout_marginStart="8dp"
            android:backgroundTint="#3B82F6"/>
    </LinearLayout>

    <TextView
        android:id="@+id/text_search_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:textSize="16sp"
        android:textColor="#333"
        android:visibility="gone"
        tools:text="검색 결과: 닉네임 (uid...)"
        tools:visibility="visible"/>

    <Button
        android:id="@+id/btn_send_request"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="친구 요청 보내기"
        android:backgroundTint="#10B981"
        android:visibility="gone"
        tools:visibility="visible"/>

    <Button
        android:id="@+id/btn_invite_friend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="친구 초대 링크 공유"
        android:backgroundTint="#2563EB"
        android:layout_marginTop="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="내 친구 목록"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="8dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:id="@+id/friend_list_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            tools:ignore="ScrollViewContents" />
    </ScrollView>
</LinearLayout>