<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <!-- 투표 관련 UI 전체 컨테이너 -->
        <LinearLayout
            android:id="@+id/layoutVoteContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

        <!-- 제목 -->
        <TextView
            android:id="@+id/tvVoteTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="최종 투표"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <!-- 초기 상태 버튼 컨테이너 (아무것도 투표 안된 상태에서만 표시) -->
        <LinearLayout
            android:id="@+id/layoutInitialButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- 시간 버튼 -->
            <LinearLayout
                android:id="@+id/btnFilterTime"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:background="@drawable/bg_chip_outline"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_event_24"
                    app:tint="@color/black"
                    android:clickable="false"
                    android:focusable="false"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="일정"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"
                    android:clickable="false"
                    android:focusable="false"/>
            </LinearLayout>

            <!-- 위치 버튼 -->
            <LinearLayout
                android:id="@+id/btnFilterLocation"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:background="@drawable/bg_chip_outline"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_place_24"
                    app:tint="@color/black"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="장소"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
            
            <!-- 투표 시작 버튼 (방장만 표시) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartVoting"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="투표 시작"
                android:textColor="@color/white"
                android:backgroundTint="@color/brand_blue"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />
            
            <!-- 투표 시작 대기 메시지 (방장이 아닌 멤버에게 표시) -->
            <TextView
                android:id="@+id/tvWaitingForHost"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="아직 방장이 투표를 시작하지 않았습니다"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:gravity="center"
                android:background="@drawable/bg_light_gray_outline"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 시간 최종 투표 섹션 -->
        <LinearLayout
            android:id="@+id/layoutFinalTimeVote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="시간을 선택하세요"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />

            <!-- 시간 리스트 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFinalTimes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="12dp" />

            <!-- 시간 투표 버튼 -->
            <Button
                android:id="@+id/btnSubmitTimeVote"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="시간 투표하기"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_button_primary"
                android:visibility="gone" />
        </LinearLayout>


        <!-- 후보 리스트 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFinalCandidates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="12dp" />

        <!-- 투표 버튼 -->
        <Button
            android:id="@+id/btnSubmitVote"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="투표하기"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_button_primary"
            android:visibility="gone" />

        </LinearLayout>
        <!-- 투표 관련 UI 전체 컨테이너 끝 -->

        <!-- 최종 위치 지도 섹션 (투표 완료 후 표시) -->
        <LinearLayout
            android:id="@+id/layoutFinalPlaceMap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="최종 확정된 장소"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="12dp" />

            <!-- 지도 프래그먼트 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginBottom="12dp">
                
                <fragment
                    android:id="@+id/mapFragment"
                    android:name="com.google.android.gms.maps.SupportMapFragment"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <!-- 사용자별 소요시간 리스트 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMemberDistances"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
