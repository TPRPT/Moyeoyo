<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <!-- 제목 + 위치/시간 버튼 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/tvVoteTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="최종 투표"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_weight="1" />

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end">

                <!-- 위치 버튼 -->
                <LinearLayout
                    android:id="@+id/btnFilterLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:background="@drawable/bg_chip_outline"
                    android:layout_marginEnd="6dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_place_24"
                        app:tint="@color/black"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="위치"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>

                <!-- 시간 버튼 -->
                <LinearLayout
                    android:id="@+id/btnFilterTime"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:background="@drawable/bg_chip_outline">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_event_24"
                        app:tint="@color/black"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="시간"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 설명 문구 -->
        <TextView
            android:id="@+id/tvVoteDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="상위 3개 장소 중 한 곳을 선택하세요"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="10dp"
            android:layout_marginTop="8dp"
            android:background="@color/gray_100"
            android:layout_marginBottom="16dp" />

        <!-- 후보 리스트 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFinalCandidates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="12dp" />

        <!-- 투표 상태 -->
        <TextView
            android:id="@+id/tvVoteStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="투표 상태: 0 / 0명 완료"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp" />

        <!-- 투표 버튼 -->
        <Button
            android:id="@+id/btnSubmitVote"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="투표하기"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_button_primary"
            android:visibility="gone" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
