<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- 상단 APP BAR -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarShare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarShare"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_chevron_left_24"
            app:title=""
            android:background="@color/white"
            app:contentInsetStartWithNavigation="0dp"/>
    </com.google.android.material.appbar.AppBarLayout>


    <!-- 전체 스크롤 영역 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/shareScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="40dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Title -->
            <TextView
                android:id="@+id/pageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="약속 공유"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textSize="22sp"
                android:layout_marginTop="16dp"
                android:paddingBottom="4dp" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/pageSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="확정된 약속을 공유하세요"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:paddingBottom="12dp"/>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/light_gray"
                android:layout_marginBottom="20dp"/>


            <!-- 약속 카드 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_purple_gradient"
                android:clipToOutline="true">

                <TextView
                    android:id="@+id/tvGroupName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="그룹명"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/white" />

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_person_24"
                        app:tint="@color/white"/>

                    <TextView
                        android:id="@+id/tvMemberCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5명"
                        android:layout_marginStart="4dp"
                        android:textColor="@color/white"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvMeetingTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="2025년 10월 20일 (일) 18:00"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/tvMeetingLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="스타벅스 역삼역점\n서울시 강남구 역삼동 123-45"
                    android:textColor="@color/white" />
            </LinearLayout>


            <!-- 공유 링크 -->
            <TextView
                android:layout_marginTop="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="공유 링크"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_search_bar"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp">

                <TextView
                    android:id="@+id/tvShareLink"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="https://meetapp.kr/meeting/abc123"
                    android:textSize="14sp"
                    android:textColor="@color/black"/>

                <ImageButton
                    android:id="@+id/btnCopyLink"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_copy"
                    android:background="@android:color/transparent"/>
            </LinearLayout>

            <TextView
                android:layout_marginTop="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="이 링크를 받은 사람은 앱 없이도 약속 정보를 볼 수 있어요"
                android:textColor="@color/gray_700"
                android:textSize="12sp"/>

            <android.widget.Button
                android:id="@+id/btnKakaoShare"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="카카오톡으로 공유"
                android:backgroundTint="@color/quantum_yellow600"
                android:textColor="@color/black"/>


            <!-- 지도 링크 -->
            <LinearLayout
                android:layout_marginTop="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/bg_lightgreen_box">

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_place_white_24"
                        app:tint="@color/green_700"/>

                    <TextView
                        android:layout_marginStart="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="지도로 보기"
                        android:textStyle="bold"
                        android:textColor="@color/green_700"/>
                </LinearLayout>

                <android.widget.Button
                    android:id="@+id/btnOpenMap"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:text="구글 지도에서 열기"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:backgroundTint="@color/white"/>
            </LinearLayout>


            <!-- 미리보기 안내 -->
            <LinearLayout
                android:layout_marginTop="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_card_light_blue"
                android:padding="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_lightbulb_24"/>

                <TextView
                    android:layout_marginStart="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="링크를 클릭한 사람은 약속 정보와 지도를 볼 수 있습니다. 앱이 있다면 앱에서, 없다면 웹에서 볼 수 있어요."
                    android:textColor="@color/brand_blue"
                    android:textSize="12sp"/>
            </LinearLayout>


            <!-- 완료 버튼 -->
            <android.widget.Button
                android:id="@+id/btnDone"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:text="완료"
                android:textColor="@color/white"
                android:background="@drawable/bg_black_button"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
