<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- 스크롤 영역 -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnNearbyPlaces"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 뒤로가기(컨테이너, TextView 아님) -->
            <LinearLayout
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_left_24"
                    app:tint="@color/black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>

            <!-- 제목 / 부제 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="중간 지점 계산"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="모두에게 공평한 중간 지점"
                android:textSize="14sp"
                android:textColor="@color/gray_600"
                android:layout_marginBottom="20dp"/>

            <!-- 계산된 중간 지점 카드 -->
            <LinearLayout
                android:id="@+id/cardCalculatedLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/bg_red_card"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_navigation_24"
                        app:tint="@color/white"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="계산된 중간 지점"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"/>
                </LinearLayout>

                <!-- 주소 행 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_place_white_24"
                        app:tint="@color/white"
                        android:layout_marginEnd="6dp"/>

                    <!-- TextView에만 아이디 부여 -->
                    <TextView
                        android:id="@+id/tvMidpointAddress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="서울시 강남구 역삼동 일대"
                        android:textColor="@color/white"
                        android:textSize="15sp"/>
                </LinearLayout>

                <!-- 좌표 박스 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="@drawable/bg_red_card_inner">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="좌표"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:layout_marginBottom="6dp"/>

                    <!-- TextView에만 아이디 부여 -->
                    <TextView
                        android:id="@+id/tvMidpointCoords"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="위도: 37.5044° / 경도: 127.0225°"
                        android:textColor="@color/white"
                        android:textSize="13sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 가까운 지하철역 카드 -->
            <LinearLayout
                android:id="@+id/cardNearestStation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_lightgreen_box"
                android:padding="16dp"
                android:layout_marginBottom="20dp"
                android:gravity="start">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_subway_24"
                        app:tint="@color/green_700"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="가장 가까운 지하철역"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvStationLineAndName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2호선  역삼역"
                    android:textColor="@color/green_700"
                    android:textSize="15sp"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvStationDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="중간 지점에서 약 350m (도보 4분)"
                    android:textColor="@color/gray_700"
                    android:textSize="13sp"/>
            </LinearLayout>

            <!-- 섹션 타이틀 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="멤버별 이동 거리"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="8dp"/>

            <!-- 예시 아이템 1 -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_outline"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="김"
                    android:textStyle="bold"
                    android:background="@drawable/bg_circle_gray"
                    android:textColor="@color/black"/>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="김철수"
                        android:textColor="@color/black"
                        android:textSize="14sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="강남구"
                        android:textColor="@color/gray_600"
                        android:textSize="12sp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2.1km\n약 7분"
                    android:textAlignment="textEnd"
                    android:textSize="13sp"
                    android:textColor="@color/black"/>
            </LinearLayout>

            <!-- 평균 이동 거리 카드 -->
            <LinearLayout
                android:id="@+id/cardAverage"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:background="@drawable/bg_light_blue_outline_button"
                android:layout_marginTop="12dp">

                <!-- 파란색 체크 아이콘 -->
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_check_blue_24"
                    app:tint="@color/brand_blue"
                    android:layout_marginEnd="10dp"/>

                <!-- 텍스트 영역 -->
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/tvAvgDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="평균 이동 거리: 2.5km"
                        android:textSize="14sp"
                        android:textColor="@color/badge_blue_text"/>

                    <TextView
                        android:id="@+id/tvMaxDeviation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="최대 편차: ±0.4km (공평한 위치)"
                        android:textSize="13sp"
                        android:textColor="@color/badge_blue_text"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 회색 구분선 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/light_gray"
        app:layout_constraintBottom_toTopOf="@id/btnNearbyPlaces"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp"/>


    <!-- 하단 고정 버튼 -->
    <Button
        android:id="@+id/btnNearbyPlaces"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="주변 장소 추천 보기"
        android:background="@drawable/bg_black_button"
        android:textColor="@color/white"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
