<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground">

    <!-- 1. 그룹 이름 (툴바 역할) -->
    <TextView
        android:id="@+id/group_name_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="그룹 이름"
        android:textSize="24sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:background="@android:color/white"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 2. 본문 스크롤 영역 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/group_name_text"
        app:layout_constraintBottom_toTopOf="@id/bottom_fixed_invite">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- 그룹 멤버 수 표시 -->
            <TextView
                android:id="@+id/member_count_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="현재 그룹 멤버 수:"
                android:textSize="18sp"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/member_count_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1명 (당신)"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#3B82F6"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="32dp"/>

            <!-- 기능 목록 (임시) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="여기에 투표, 장소, 시간 선택 기능이 들어갑니다."
                android:textColor="@color/gray_500"
                android:layout_marginTop="40dp" />

        </LinearLayout>
    </ScrollView>

    <!-- 3. 하단 고정 버튼 영역 -->
    <LinearLayout
        android:id="@+id/bottom_fixed_invite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:padding="16dp"
        android:elevation="8dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btn_invite_friends"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="0.65"
            android:text="친구 초대하기"
            android:textSize="18sp"
            android:textStyle="bold"
            android:drawableStart="@drawable/ic_link"
            android:drawablePadding="8dp"
            android:backgroundTint="#3B82F6"
            android:layout_marginEnd="10dp"/> <Button
            android:id="@+id/btn_delete_group"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="0.35"
            android:text="삭제"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#EF4444"
            android:layout_marginEnd="0dp" /> </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>