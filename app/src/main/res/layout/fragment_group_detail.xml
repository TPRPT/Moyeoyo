<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- 상단 툴바 -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="2dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/white"
            app:navigationIcon="@drawable/ic_chevron_left_24"
            app:titleTextColor="@color/black"
            app:subtitleTextColor="@color/text_secondary"
            app:menu="@menu/group_detail_menu" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- 전체 스크롤 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="40dp">

            <!-- 모임명 / 멤버수 -->
            <TextView
                android:id="@+id/tvGroupName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="대학 동기들"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvMemberCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="멤버 5명"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- 오른쪽: 그룹 삭제 버튼 -->
            <Button
                android:id="@+id/btnDeleteGroup"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:layout_gravity="end|center_vertical"
                android:backgroundTint="@color/light_gray_bg"
                android:elevation="2dp"
                android:text="그룹 삭제"
                android:textColor="@color/black"
                android:textSize="12sp" />


            <!-- 다음 모임 카드 -->
            <LinearLayout
                android:id="@+id/nextMeetingCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_header_blue"
                android:clipToOutline="true"
                android:visibility="gone">

                <TextView
                    android:id="@+id/labelNext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="다음 모임"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_event_24"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/tvMeetingDateAndTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="2025년 10월 20일 (일) 18:00"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDDay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="D-5"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:background="@drawable/bg_badge_blue"
                        android:textColor="@color/badge_blue_text"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_place_24"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/tvMeetingLocation"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="스타벅스 역삼역점"
                        android:textColor="@color/white"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnAddToCalendarWrapper"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_light_blue_outline_button"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_event_24"
                        app:tint="@color/white"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/btnAddToCalendar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="캘린더에 추가"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- 투표중 카드 -->
            <LinearLayout
                android:id="@+id/votingStatusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:padding="16dp"
                android:background="@drawable/bg_vote_card_light"
                android:visibility="gone">

                <!-- 상단 : 타이틀 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:src="@drawable/ic_circle_filled"
                        app:tint="@color/brand_orange"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="투표 진행중"
                        android:textColor="@color/brand_orange"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="진행중"
                        android:textColor="@color/white"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:textSize="12sp"
                        android:background="@drawable/bg_badge_orange_filled" />
                </LinearLayout>

                <!-- 시간 투표 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp"
                    android:padding="12dp"
                    android:background="@drawable/bg_white_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_event_24"
                            app:tint="@color/brand_orange" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="시간 투표"
                            android:textColor="@color/black"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTimeVoteCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3/8명 참여"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/timeVoteProgress"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="6dp"
                        android:progress="40"
                        android:max="100"
                        android:progressDrawable="@drawable/bg_vote_progress"
                        android:indeterminateOnly="false" />
                </LinearLayout>

                <!-- 장소 투표 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp"
                    android:padding="12dp"
                    android:background="@drawable/bg_white_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_place_24"
                            app:tint="@color/brand_orange" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="장소 투표"
                            android:textColor="@color/black"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPlaceVoteCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4/8명 참여"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/placeVoteProgress"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="6dp"
                        android:progress="50"
                        android:max="100"
                        android:progressDrawable="@drawable/bg_vote_progress"
                        android:indeterminateOnly="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- Figma 스타일 탭 -->
            <RadioGroup
                android:id="@+id/tabGroup"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_segment_container"
                android:padding="3dp">

                <RadioButton
                    android:id="@+id/tabPlace"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="장소"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:button="@null"
                    android:gravity="center"
                    android:background="@drawable/bg_segment_selected_left" />

                <RadioButton
                    android:id="@+id/tabMember"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="멤버"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:button="@null"
                    android:gravity="center"
                    android:background="@drawable/bg_segment_selected_right" />
            </RadioGroup>


            <!-- ViewPager -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
