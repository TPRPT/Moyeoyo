<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB"
    tools:context=".ui.vote.ConfirmActivity">

    <LinearLayout
        android:id="@+id/header_layout_confirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="32dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp"
        android:background="@android:color/white"
        android:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/back_button_confirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_arrow_back"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="뒤로가기" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="캘린더 연동"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="확정된 약속을 캘린더에 추가하세요"
            android:textColor="@color/gray_600"
            android:textSize="16sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/header_layout_confirm"
        app:layout_constraintBottom_toTopOf="@id/bottom_fixed_save_layout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="일정 정보"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="제목"
                android:textColor="@color/gray_600"
                android:layout_marginBottom="4dp"/>
            <EditText
                android:id="@+id/input_title"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="예: 대학 동기들 모임"
                android:background="@drawable/bg_input_rounded"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="날짜"
                        android:textColor="@color/gray_600"
                        android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/input_date"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="날짜 선택"
                        android:focusable="false"
                        android:clickable="true"
                        android:background="@drawable/bg_input_rounded"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="시간"
                        android:textColor="@color/gray_600"
                        android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/input_time"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="시간 선택"
                        android:focusable="false"
                        android:clickable="true"
                        android:background="@drawable/bg_input_rounded"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="장소"
                android:textColor="@color/gray_600"
                android:layout_marginBottom="4dp"/>
            <EditText
                android:id="@+id/input_place"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="장소 검색/선택"
                android:focusable="false"
                android:clickable="true"
                android:background="@drawable/bg_input_rounded"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="메모"
                android:textColor="@color/gray_600"
                android:layout_marginBottom="4dp"/>
            <EditText
                android:id="@+id/input_memo"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:hint="약속에 대한 추가 정보를 입력하세요"
                android:gravity="top"
                android:background="@drawable/bg_input_rounded"
                android:padding="16dp"
                android:layout_marginBottom="32dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="캘린더 선택"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btn_add_to_google_calendar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Google Calendar에 추가"
                android:textColor="@color/black"
                android:backgroundTint="#F0F0F0"
                android:drawableStart="@drawable/ic_google_calendar"
                android:drawablePadding="16dp"
                android:paddingStart="24dp"
                app:drawableTint="#4285F4"  android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btn_add_to_other_app"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="다른 캘린더 앱에 추가"
                android:textColor="@color/black"
                android:backgroundTint="#F0F0F0"
                android:drawableStart="@drawable/ic_calendar_other"
                android:drawablePadding="16dp"
                android:paddingStart="24dp"
                app:drawableTint="#757575"  android:layout_marginBottom="32dp"/>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottom_fixed_save_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:padding="16dp"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btn_confirm_schedule"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="일정 확정 및 캘린더 저장"
            android:textSize="18sp"
            android:textStyle="bold"
            android:enabled="false"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>