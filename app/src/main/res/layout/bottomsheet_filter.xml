<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- 상단 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:text="필터 설정"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnCloseFilter"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_close_24" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="원하는 조건으로 장소를 필터링하세요"
        android:textSize="14sp"
        android:textColor="@color/gray_700"
        android:layout_marginBottom="20dp" />


    <!-- 🚗 이동수단 필터 -->
    <LinearLayout
        android:id="@+id/layoutTransport"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_transport_group"
        android:padding="3dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/btnWalk"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="도보"
            android:textSize="14sp"
            android:background="@drawable/bg_transport_unselected"
            android:textColor="@color/black"/>

        <TextView
            android:id="@+id/btnTransit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="대중교통"
            android:textSize="14sp"
            android:background="@drawable/bg_transport_selected"
            android:textColor="@color/white"/>

        <TextView
            android:id="@+id/btnCar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="자동차"
            android:textSize="14sp"
            android:background="@drawable/bg_transport_unselected"
            android:textColor="@color/black"/>
    </LinearLayout>


    <!-- 최대 거리 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:text="최대 거리"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvMaxDistanceValue"
            android:text="5km"
            android:textSize="14sp"
            android:textColor="@color/gray_700"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <SeekBar
        android:id="@+id/seekBarDistance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="50"
        android:progressTint="@color/black"
        android:thumbTint="@color/black"
        android:layout_marginBottom="20dp" />

    <!-- 최소 평점 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:text="최소 평점"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvMinRatingValue"
            android:text="0점 이상"
            android:textSize="14sp"
            android:textColor="@color/gray_700"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <SeekBar
        android:id="@+id/seekBarRating"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="50"
        android:progress="0"
        android:progressTint="@color/black"
        android:thumbTint="@color/black"
        android:layout_marginBottom="24dp" />

    <!-- 필터 적용 버튼 -->
    <android.widget.Button
        android:id="@+id/btnApplyFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_black_button"
        android:text="필터 적용"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:padding="10dp"
        android:layout_marginTop="8dp"/>
</LinearLayout>
