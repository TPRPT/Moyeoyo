<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <!-- 제목 + 칩 오른쪽 정렬 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/tvPlaceListTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="추천 장소"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_weight="1" />

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end">

                <LinearLayout
                    android:id="@+id/btnFilterLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:background="@drawable/bg_chip_outline"
                    android:layout_marginEnd="6dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_place_24"
                        app:tint="@color/black"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="위치"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnFilterTime"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:background="@drawable/bg_chip_outline">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_event_24"
                        app:tint="@color/black"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="시간"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ✅ 연두색 중간 지점 카드 -->
        <LinearLayout
            android:id="@+id/layoutMiddlePoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_middle_point"
            android:padding="12dp"
            android:layout_marginTop="12dp"
            android:visibility="visible"
            android:gravity="start"> <!-- 왼쪽 정렬 -->

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_place_24"
                    app:tint="@color/brand_green" />

                <TextView
                    android:id="@+id/tvMiddleTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="중간 지점"
                    android:textColor="@color/brand_green"
                    android:textStyle="bold"
                    android:textSize="14sp"/>
            </LinearLayout>

            <!-- 모든 텍스트 왼쪽 정렬 맞춤 -->
            <TextView
                android:id="@+id/tvMiddleAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="서울시 강남구 역삼동 일대"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:layout_marginTop="4dp"
                android:layout_marginStart="24dp"/> <!-- 아이콘 라인 정렬 -->

            <TextView
                android:id="@+id/tvMiddleDistance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="모든 멤버의 평균 이동거리: 2.5km"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp"
                android:layout_marginStart="24dp"/> <!-- 아이콘 라인 정렬 -->
        </LinearLayout>

        <!-- ✅ 장소 리스트 (NestedScrollView 안에 있어서 스크롤 가능) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerPlaceList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:overScrollMode="never"
            android:nestedScrollingEnabled="false"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
