<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- 스크롤 가능한 메인 콘텐츠 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="140dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 뒤로가기 버튼 -->
            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chevron_left_24"
                android:contentDescription="@string/back"
                app:tint="@color/black" />

            <!-- 제목 -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/location_input_title"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/location_input_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp" />

            <!-- 구분선 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/light_gray"
                android:layout_marginBottom="16dp" />

            <!-- 현재 위치 사용 버튼 -->
            <LinearLayout
                android:id="@+id/btn_use_current_location"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_light_blue_outline_button"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_near_me_24"
                    app:tint="@color/brand_blue"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/use_current_location"
                    android:textColor="@color/brand_blue"
                    android:textStyle="bold"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 자주 사용하는 위치 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/frequently_used_places"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="10dp" />

            <!-- 집 / 회사 영역 (RelativeLayout 구조) -->
            <include layout="@layout/item_location_home"/>
            <include layout="@layout/item_location_work"/>

            <!-- 주소 검색 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="주소 검색"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="10dp" />

            <!-- 돋보기 포함 검색창 -->
            <LinearLayout
                android:id="@+id/layoutSearchBar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_search_bar"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search_24"
                    app:tint="#757575"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/et_search_address"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="주소, 건물명, 지하철역 검색"
                    android:textColorHint="#757575"
                    android:textColor="#424242"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 선택된 위치 박스 (기본적으로 숨김) -->
            <LinearLayout
                android:id="@+id/layout_selected_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_selected_location_box"
                android:padding="12dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_check_green_24"
                        app:tint="@color/brand_green" />

                    <TextView
                        android:id="@+id/tv_selected_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="선택된 위치"
                        android:textColor="@color/brand_green"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_marginStart="6dp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_selected_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="현재 위치"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:layout_marginTop="4dp"
                    android:layout_marginStart="24dp" />

                <TextView
                    android:id="@+id/tv_selected_address"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="서울시 강남구 역삼동 123-45"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp"
                    android:layout_marginStart="24dp"/>
            </LinearLayout>


            <!-- 안내문 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💡 모든 멤버의 위치가 입력되면 최적의 중간 지점을 계산합니다"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_light_blue_outline_button"
                android:padding="12dp" />
        </LinearLayout>
    </ScrollView>

    <!-- 하단 고정 버튼 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@color/white"
        android:elevation="6dp"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/light_gray"
            android:layout_marginBottom="16dp" />

        <android.widget.Button
            android:id="@+id/btn_confirm_location"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="위치 확정하기"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/bg_button_location_confirm"
            android:layout_gravity="bottom"
            android:layout_marginBottom="16dp" />


    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
